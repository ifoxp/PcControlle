# Секрети — НІКОЛИ не комітити
.env

# Стан застосунку (генерується під час роботи)
*.log
# логи збірки (напр. mobile_app/_build_apk.log)
_*.log
sorter_log.txt
sorter_checked.json
sorter_trashed.json
sorter_synced.json
sorter_state.json
volume_offsets.json
screenshots/
# нативні крах-дампи біля exe
crash_native/

# Python
__pycache__/
*.py[cod]
.venv/
build/
dist/
# готові дистрибутиви (ZIP/APK) — артефакти збірки
release/

# IDE
.idea/
.vscode/

# Claude Code — локальні налаштування (дозволи конкретної машини)
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Зібраний APK (артефакт, не комітимо)
*.apk

# TLS-сертифікати API (генеруються локально, приватний ключ)
cert.pem
key.pem

# Реєстр парованих пристроїв (містить хеші токенів)
devices.json

# Аудит-лог безпеки
security_audit.log

# Згенеровані іконки (можна перегенерувати: python tools/make_icon.py)
# pc_control/assets/  — лишаємо в репо, бо потрібні для збірки
_*.png

# Сторонній інструмент яскравості/моніторів (бінарник)
MultiMonitorTool.exe
MultiMonitorTool.cfg

# Cloudflare tunnel binary (завантажується застосунком)
cloudflared.exe
